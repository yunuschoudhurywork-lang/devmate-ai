# Obtain a key from Google AI Studio. Keep this file local and never commit .env.
GEMINI_API_KEY=your_gemini_api_key
# Stable, low-cost text model used for finding explanations.
GEMINI_MODEL=gemini-3.5-flash-lite

# PostgreSQL database connection string for analysis history
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Example: postgresql://devmate:password@localhost:5432/devmate_dev
DATABASE_URL=postgresql://localhost:5432/devmate_dev
