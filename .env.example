# Obtain a key from Google AI Studio. Keep this file local and never commit .env.
GEMINI_API_KEY=your_gemini_api_key
# Stable, low-cost text model used for finding explanations.
GEMINI_MODEL=gemini-3.5-flash-lite

# PostgreSQL database connection string for analysis history
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Example: postgresql://devmate:password@localhost:5432/devmate_dev
DATABASE_URL=postgresql://localhost:5432/devmate_dev

# WorkOS AuthKit Configuration
# Get these from: https://dashboard.workos.com/
WORKOS_API_KEY=sk_test_YOUR_WORKOS_API_KEY_HERE
WORKOS_CLIENT_ID=client_YOUR_WORKOS_CLIENT_ID_HERE
WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback
# Secret for encrypting session cookies (generate a secure random string)
WORKOS_COOKIE_PASSWORD=GENERATE_A_SECURE_32_CHARACTER_STRING_HERE
# Frontend URL for redirects after authentication
FRONTEND_URL=http://localhost:5173
