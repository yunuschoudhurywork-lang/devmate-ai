// Database schema for DevMate AI: users, projects, reports and AI artifacts

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?
  name         String?
  avatarUrl    String?
  // "local" for email/password accounts, "github" for GitHub OAuth accounts
  provider     String   @default("local")
  githubId     String?  @unique
  githubLogin  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reports   Report[]
  projects  Project[]
  artifacts AiArtifact[]

  @@index([githubId])
}

model Project {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  repoUrl       String?
  repoFullName  String?
  // "github" | "manual"
  provider      String   @default("manual")
  defaultBranch String   @default("main")
  language      String?
  visibility    String   @default("private")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  reports Report[]

  @@unique([userId, repoFullName])
  @@index([userId])
  @@index([createdAt])
}

model Report {
  id        String   @id @default(uuid())
  language  String
  filename  String?
  createdAt DateTime @default(now())

  // Owner relationship (nullable for legacy anonymous reports)
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Repository / project relationship
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  // Summary counts
  totalFindings    Int
  errorCount       Int
  warningCount     Int
  securityCount    Int
  performanceCount Int

  // Quality scores
  overallScore     Int
  correctnessScore Int
  securityScore    Int
  performanceScore Int

  findings      Finding[]
  reviewSummary ReviewSummary?
  explanations  Explanation[]
  artifacts     AiArtifact[]

  @@index([createdAt])
  @@index([userId])
  @@index([projectId])
}

model Finding {
  id       String @id @default(uuid())
  reportId String
  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  type       String
  severity   String
  line       Int
  message    String
  ruleId     String
  suggestion String?

  explanations Explanation[]

  @@index([reportId])
}

model ReviewSummary {
  id       String @id @default(uuid())
  reportId String @unique
  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  summary String
  // JSON-encoded string arrays (SQLite has no native array type)
  keyRisks   String
  priorities String
  caveats    String
  createdAt  DateTime @default(now())
}

model Explanation {
  id       String @id @default(uuid())
  reportId String
  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  findingId String
  finding   Finding @relation(fields: [findingId], references: [id], onDelete: Cascade)

  explanation  String
  suggestedFix String
  caveats      String
  createdAt    DateTime @default(now())

  @@unique([reportId, findingId])
  @@index([reportId])
  @@index([findingId])
}

model AiArtifact {
  id       String  @id @default(uuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  reportId String?
  report   Report? @relation(fields: [reportId], references: [id], onDelete: Cascade)

  // "review" | "pr-comments" | "security-fixes" | "refactor" | "bug-explanations"
  kind     String
  title    String
  provider String
  model    String
  // JSON-encoded AI response payload
  content  String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([reportId])
}
